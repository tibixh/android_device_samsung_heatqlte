on property:sys.boot_completed=1
    # re-run link_ril_db as its start runs prematurely on a first boot.
    start link_ril_db

    # restart rild as our old ril only report simcard state after the radio is fully up.
    wait /data/data/com.android.providers.telephony/databases/telephony.db 5
    restart ril-daemon
